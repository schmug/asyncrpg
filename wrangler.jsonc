{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "asyncrpg",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],

  "observability": { "enabled": true },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "durable_objects": {
    "bindings": [{ "name": "CAMPAIGN", "class_name": "CampaignDO" }]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CampaignDO"]
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "asyncrpg",
      "database_id": "2f67e65f-cff8-4a16-8167-494b2581ab4f",
      "migrations_dir": "migrations"
    }
  ],

  "send_email": [{ "name": "EMAIL" }],

  "routes": [{ "pattern": "play.cortech.online", "custom_domain": true }],

  "vars": {
    // The web app lives on the subdomain, but mail must come from the apex:
    // Email Sending and Email Routing are onboarded on cortech.online, and
    // Cloudflare has no API for adding a subdomain to either (the flow is
    // Dashboard-only). Sending from an un-onboarded domain silently fails.
    "MAIL_DOMAIN": "cortech.online",
    "PUBLIC_ORIGIN": "https://play.cortech.online",
    // Narration model tiers. Overridden per-environment if needed.
    // Sonnet 5 writes the beat players read; Haiku 4.5 does the cheap
    // high-volume work (intent parsing, recaps). Note Haiku 4.5 does not
    // support `output_config.effort` — never send it on the cheap tier.
    "MODEL_NARRATE": "claude-sonnet-5",
    "MODEL_CHEAP": "claude-haiku-4-5",
    // Monthly per-campaign output-token budget. Exceeding it degrades
    // narration to templated sim prose; it never blocks a tick.
    "CAMPAIGN_MONTHLY_TOKEN_BUDGET": "400000"
  }

  // Secrets (set via `wrangler secret put`, never committed):
  //   ANTHROPIC_API_KEY   — DM narration; absent ⇒ templated sim prose
  //   EMAIL_TOKEN_SECRET  — HMAC key for reply subaddress tokens
  //   AUTH_TOKEN_SECRET   — HMAC key for magic-link sessions
}
