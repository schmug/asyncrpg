{
  "name": "asyncrpg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Asynchronous multiplayer tabletop RPG with a simulated world and an LLM dungeon master. Play by email or web.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --var GIT_REVISION:$(git rev-parse HEAD)",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim:soak": "tsx scripts/sim-soak.ts",
    "smoke": "node scripts/smoke.mjs",
    "ui-smoke": "node scripts/ui-smoke.mjs",
    "critic": "node scripts/critic.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@cloudflare/workers-types": "^5.20260801.1",
    "@types/node": "^26.1.2",
    "@vitest/runner": "^4.1.10",
    "@vitest/snapshot": "^4.1.10",
    "playwright": "^1.62.1",
    "tsx": "^4.23.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "postal-mime": "^2.7.5"
  }
}
